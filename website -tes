<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Sederhana Saya</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f4f4;
            color: #333;
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        nav {
            background-color: #333;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            padding: 15px 25px;
            text-decoration: none;
            transition: background 0.3s;
        }

        nav a:hover {
            background-color: #667eea;
        }

        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }

        section {
            background: white;
            padding: 25px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        section h2 {
            color: #667eea;
            margin-bottom: 15px;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
        }

        ul {
            padding-left: 20px;
        }

        ul li {
            margin-bottom: 8px;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        input, textarea {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1em;
        }

        button {
            background-color: #667eea;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #764ba2;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Selamat Datang di Website Saya</h1>
        <p>Website sederhana dengan HTML dan CSS</p>
    </header>

    <!-- Navigasi -->
    <nav>
        <a href="#home">Home</a>
        <a href="#tentang">Tentang</a>
        <a href="#layanan">Layanan</a>
        <a href="#kontak">Kontak</a>
    </nav>

    <!-- Konten -->
    <div class="container">

        <section id="home">
            <h2>Home</h2>
            <p>Ini adalah halaman utama website sederhana. Anda bisa mengubah konten ini sesuai kebutuhan Anda.</p>
        </section>

        <section id="tentang">
            <h2>Tentang Saya</h2>
            <p>Halo! Saya sedang belajar membuat website menggunakan HTML dan CSS. Website ini dibuat sebagai latihan dasar.</p>
        </section>

        <section id="layanan">
            <h2>Layanan</h2>
            <ul>
                <li>Pembuatan Website Statis</li>
                <li>Desain Responsif</li>
                <li>Konsultasi Web Development</li>
                <li>Maintenance Website</li>
            </ul>
        </section>

        <section id="kontak">
            <h2>Kontak</h2>
            <form onsubmit="kirimPesan(event)">
                <input type="text" placeholder="Nama Anda" required>
                <input type="email" placeholder="Email Anda" required>
                <textarea rows="5" placeholder="Pesan Anda" required></textarea>
                <button type="submit">Kirim Pesan</button>
            </form>
        </section>

    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2025 Website Sederhana Saya. All rights reserved.</p>
    </footer>

    <!-- JavaScript -->
    <script>
        function kirimPesan(event) {
            event.preventDefault();
            alert('Terima kasih! Pesan Anda telah dikirim.');
            event.target.reset();
        }
    </script>

</body>
</html>
